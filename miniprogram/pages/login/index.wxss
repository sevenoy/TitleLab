.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx);
  overflow-x: hidden;
  background: #f6f8fb;
  color: #111827;
}

.login-card {
  padding: 36rpx 28rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 24rpx;
  background: #ffffff;
}

.brand-mark {
  width: 92rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.brand-title,
.brand-subtitle,
.safe-note {
  display: block;
}

.brand-title {
  margin-top: 24rpx;
  color: #111827;
  font-size: 42rpx;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 700;
}

.safe-note {
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.55;
}

.form-field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
  color: #111827;
  font-size: 27rpx;
}

.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 26rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.link-button {
  min-height: 42rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #1677ff;
  font-size: 24rpx;
  line-height: 42rpx;
}

.login-button {
  width: 100%;
  min-height: 78rpx;
  margin-top: 30rpx;
  border-radius: 20rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 78rpx;
}
