.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
  background: #f4f7fb;
  color: #111827;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.brand-block {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 16rpx;
}

.logo-mark {
  width: 88rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #0f6fdc;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.tab-switch {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 6rpx;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #eef3ff;
}

.tab-button {
  min-width: 0;
  min-height: 54rpx;
  flex: 1;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 8rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 54rpx;
}

.tab-button.active {
  background: #0f6fdc;
  color: #ffffff;
  font-weight: 700;
}

.settings-button {
  width: 96rpx;
  min-height: 56rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1e64d8;
  font-size: 24rpx;
  line-height: 56rpx;
}

.category-panel,
.toolbar-panel,
.content-section {
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-head.compact {
  margin-bottom: 14rpx;
}

.section-title {
  min-width: 0;
  color: #111827;
  font-size: 29rpx;
  font-weight: 800;
}

.section-note {
  flex-shrink: 0;
  color: #4b5563;
  font-size: 22rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.category-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 66rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #fbfdff;
}

.category-row.active {
  border-color: #0f6fdc;
  background: #eaf4ff;
}

.category-name {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 12rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
}

.category-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-count {
  flex-shrink: 0;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 500;
}

.category-tools {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  max-width: 250rpx;
}

.tool-button {
  min-width: 62rpx;
  min-height: 44rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #0f6fdc;
  font-size: 21rpx;
  line-height: 44rpx;
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f6f8fc;
  color: #111827;
  font-size: 27rpx;
}

.search-placeholder {
  color: #8a94a6;
}

.account-picker {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 25rpx;
}

.account-label {
  flex-shrink: 0;
}

.account-value {
  min-width: 0;
  overflow: hidden;
  color: #111827;
  font-weight: 700;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.primary-action,
.secondary-action {
  min-width: 0;
  min-height: 60rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.primary-action {
  background: #0f6fdc;
  color: #ffffff;
  font-weight: 700;
}

.secondary-action {
  border: 1rpx solid #d7e6ff;
  background: #eef3ff;
  color: #1e64d8;
}

.library-row {
  padding: 18rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.library-row + .library-row {
  margin-top: 14rpx;
}

.row-main {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 14rpx;
}

.star-index {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #eaf4ff;
  color: #0f6fdc;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.row-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.row-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.row-meta {
  color: #4b5563;
  font-size: 22rpx;
}

.row-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.row-button {
  min-width: 0;
  min-height: 52rpx;
  margin: 0;
  padding: 0 6rpx;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #f6f8fc;
  color: #1e64d8;
  font-size: 23rpx;
  line-height: 52rpx;
}

.row-button.danger {
  color: #d94c4c;
}

.copy-detail-box {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f6f8fc;
}

.copy-line {
  color: #111827;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}
