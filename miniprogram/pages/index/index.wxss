.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  background: #f4f7fb;
  color: #111827;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.brand-block {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 18rpx;
}

.logo-mark {
  width: 96rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #1890ff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.tab-switch {
  display: flex;
  padding: 6rpx;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #eef3ff;
}

.tab-button {
  min-width: 104rpx;
  min-height: 56rpx;
  margin: 0;
  border-radius: 8rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 56rpx;
}

.tab-button.active {
  background: #1890ff;
  color: #ffffff;
  font-weight: 700;
}

.user-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #111827;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.exit-button {
  min-width: 76rpx;
  min-height: 52rpx;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  color: #4b5563;
  font-size: 23rpx;
  line-height: 52rpx;
}

.category-panel,
.toolbar-panel,
.content-section {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-head.compact {
  margin-bottom: 14rpx;
}

.section-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 800;
}

.section-note {
  color: #4b5563;
  font-size: 23rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 66rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #fbfdff;
}

.category-row.active {
  border-color: #1890ff;
  background: #e5f3ff;
}

.category-name {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
}

.category-count {
  color: #4b5563;
  font-size: 23rpx;
  font-weight: 500;
}

.category-tools {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}

.tool-button {
  min-width: 62rpx;
  min-height: 44rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #1890ff;
  font-size: 21rpx;
  line-height: 44rpx;
}

.search-input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f6f8fc;
  color: #111827;
  font-size: 27rpx;
}

.search-placeholder {
  color: #8a94a6;
}

.account-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 25rpx;
}

.account-value {
  overflow: hidden;
  color: #111827;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.primary-action,
.secondary-action {
  min-height: 60rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.primary-action {
  background: #1890ff;
  color: #ffffff;
  font-weight: 700;
}

.secondary-action {
  border: 1rpx solid #d7e6ff;
  background: #eef3ff;
  color: #1e64d8;
}

.secondary-action.small {
  min-width: 128rpx;
  min-height: 52rpx;
  font-size: 23rpx;
  line-height: 52rpx;
}

.library-row {
  padding: 18rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.library-row + .library-row {
  margin-top: 14rpx;
}

.row-main {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.star-index {
  flex-shrink: 0;
  min-width: 82rpx;
  color: #1890ff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.row-title {
  flex: 1;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.toggle-button {
  flex-shrink: 0;
  min-width: 70rpx;
  min-height: 46rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #1890ff;
  font-size: 22rpx;
  line-height: 46rpx;
}

.row-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.row-button {
  min-height: 52rpx;
  padding: 0 8rpx;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #f6f8fc;
  color: #1e64d8;
  font-size: 23rpx;
  line-height: 52rpx;
}

.row-button.ai {
  background: #dff0ff;
  color: #1890ff;
  font-weight: 700;
}

.row-button.danger {
  color: #e85b5b;
}

.inline-ai-panel {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #cfe5ff;
  border-radius: 8rpx;
  background: #f6fbff;
}

.ai-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-title {
  color: #111827;
  font-size: 27rpx;
  font-weight: 800;
}

.local-badge {
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  background: #e5f3ff;
  color: #1890ff;
  font-size: 22rpx;
}

.ai-source {
  display: block;
  margin-top: 12rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.45;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.chip {
  min-height: 48rpx;
  padding: 0 14rpx;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 48rpx;
}

.chip.active {
  background: #1890ff;
  color: #ffffff;
}

.ai-result-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) 88rpx 142rpx;
  gap: 10rpx;
  align-items: center;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.ai-result-index {
  color: #1890ff;
  font-size: 24rpx;
  font-weight: 800;
}

.ai-result-text {
  color: #111827;
  font-size: 24rpx;
  line-height: 1.45;
}

.ai-mini-button {
  min-height: 46rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #1e64d8;
  font-size: 21rpx;
  line-height: 46rpx;
}

.ai-mini-button.add {
  background: #e5f3ff;
  color: #1890ff;
}

.ai-footer {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 14rpx;
}

.copy-detail-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f6f8fc;
}

.copy-line {
  color: #111827;
  font-size: 25rpx;
  line-height: 1.55;
}
