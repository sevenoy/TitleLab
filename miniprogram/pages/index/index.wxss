.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 28rpx);
  overflow-x: hidden;
  background: #f6f8fb;
  color: #111827;
}

.hero-bar,
.workspace-panel,
.content-section {
  box-sizing: border-box;
  border: 1rpx solid #e5eaf2;
  border-radius: 24rpx;
  background: #ffffff;
}

.hero-bar {
  padding: 22rpx;
}

.brand-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-left {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 14rpx;
}

.logo-mark {
  width: 64rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.brand-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.app-title,
.account-state,
.section-title,
.section-note,
.empty-title,
.empty-copy {
  display: block;
}

.app-title {
  color: #111827;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.15;
}

.account-state {
  color: #6b7280;
  font-size: 23rpx;
}

.tab-switch {
  display: flex;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #eef4ff;
}

.tab-button {
  min-width: 0;
  min-height: 64rpx;
  flex: 1;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 16rpx;
  color: #6b7280;
  font-size: 27rpx;
  line-height: 64rpx;
}

.tab-button.active {
  background: #1677ff;
  color: #ffffff;
  font-weight: 700;
}

.settings-button {
  min-width: 92rpx;
  min-height: 56rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #dbe8ff;
  border-radius: 16rpx;
  background: #f5f8ff;
  color: #1677ff;
  font-size: 24rpx;
  line-height: 56rpx;
}

.workspace-panel {
  margin-top: 18rpx;
  padding: 20rpx;
}

.search-row,
.filter-head,
.list-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-row {
  align-items: stretch;
}

.section-title {
  min-width: 0;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.section-note {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.search-input {
  box-sizing: border-box;
  min-width: 0;
  min-height: 72rpx;
  flex: 1;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
  color: #111827;
  font-size: 26rpx;
}

.search-placeholder {
  color: #8a94a6;
}

.primary-action {
  min-width: 156rpx;
  min-height: 72rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.filter-head {
  justify-content: space-between;
  margin-top: 18rpx;
}

.account-filter {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
  min-height: 54rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 23rpx;
}

.account-label {
  flex-shrink: 0;
}

.account-value {
  min-width: 0;
  overflow: hidden;
  color: #111827;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-link,
.subtle-button {
  min-height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #dbe8ff;
  border-radius: 999rpx;
  background: #f5f8ff;
  color: #1677ff;
  font-size: 23rpx;
  line-height: 54rpx;
}

.chip-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.chip-track {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 2rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #dbe8ff;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 24rpx;
  line-height: 58rpx;
}

.filter-chip.active {
  border-color: #1677ff;
  background: #1677ff;
  color: #ffffff;
}

.chip-count {
  font-size: 21rpx;
  opacity: 0.78;
}

.list-header {
  justify-content: space-between;
  margin: 24rpx 4rpx 12rpx;
}

.library-row {
  padding: 22rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 22rpx;
  background: #ffffff;
}

.library-row + .library-row {
  margin-top: 16rpx;
}

.row-main {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 14rpx;
}

.star-index {
  min-width: 62rpx;
  height: 44rpx;
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #eaf4ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.row-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.row-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.row-meta {
  color: #6b7280;
  font-size: 23rpx;
}

.row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.row-button {
  min-width: 0;
  min-height: 52rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #dbe8ff;
  border-radius: 999rpx;
  background: #f6f8fc;
  color: #1677ff;
  font-size: 23rpx;
  line-height: 52rpx;
}

.row-button.danger {
  color: #d94c4c;
}

.copy-detail-box {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
}

.copy-line {
  color: #111827;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}

.empty-state {
  padding: 56rpx 24rpx;
  border: 1rpx dashed #d8e2f1;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-copy {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 25rpx;
}
