<view class="page-shell">
  <view class="hero">
    <text class="pill">本地只读样例</text>
    <text class="hero-title">标题与文案素材</text>
    <text class="hero-subtitle">先验证列表、筛选、详情和复制闭环，后续 API 接入单独过 gate。</text>
  </view>

  <view class="search-panel">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索标题、正文、分类或标签"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onSearchInput"
    />

    <view class="filter-grid">
      <picker range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="filter-control">
          <text class="filter-label">类型</text>
          <text class="filter-value">{{typeLabel}}</text>
        </view>
      </picker>

      <picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="filter-control">
          <text class="filter-label">分类</text>
          <text class="filter-value">{{categoryLabel}}</text>
        </view>
      </picker>

      <picker range="{{tagOptions}}" range-key="label" value="{{tagIndex}}" bindchange="onTagChange">
        <view class="filter-control">
          <text class="filter-label">标签</text>
          <text class="filter-value">{{tagLabel}}</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="list-header">
    <text class="result-count">{{total}} 条内容</text>
    <button class="clear-button" bindtap="onClearFilters">重置</button>
  </view>

  <view wx:if="{{items.length}}" class="content-list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="content-card"
      bindtap="onOpenDetail"
      data-id="{{item.id}}"
    >
      <view class="card-head">
        <text class="type-badge">{{item.typeLabel}}</text>
        <text class="category-text">{{item.category}}</text>
      </view>
      <text class="card-title">{{item.title}}</text>
      <text class="card-body">{{item.body}}</text>
      <view class="tag-row">
        <text wx:for="{{item.tags}}" wx:key="*this" class="tag">#{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-title">没有匹配内容</text>
    <text class="empty-copy">换个关键词，或重置筛选后再看。</text>
  </view>
</view>
