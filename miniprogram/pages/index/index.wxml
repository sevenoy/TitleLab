<view class="page-shell">
  <view class="hero-bar">
    <view class="brand-line">
      <view class="brand-left">
        <view class="logo-mark">THE</view>
        <view class="brand-copy">
          <text class="app-title">TitleLab</text>
          <text class="account-state">{{currentAccountLabel}}</text>
        </view>
      </view>
      <button class="settings-button" bindtap="onOpenSettings">设置</button>
    </view>

    <view class="tab-switch" aria-label="内容类型">
      <button class="tab-button {{activeTab === 'title' ? 'active' : ''}}" data-tab="title" bindtap="onSwitchTab">标题</button>
      <button class="tab-button {{activeTab === 'copy' ? 'active' : ''}}" data-tab="copy" bindtap="onSwitchTab">文案</button>
    </view>
  </view>

  <view class="workspace-panel">
    <view class="search-row">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{activeTab === 'title' ? '搜索标题关键词' : '搜索文案关键词'}}"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <button wx:if="{{activeTab === 'title'}}" class="primary-action" data-action="新增标题" bindtap="onLocalAction">新增标题</button>
      <button wx:if="{{activeTab === 'copy'}}" class="primary-action" data-action="新增文案" bindtap="onLocalAction">新增文案</button>
    </view>

    <view class="filter-head">
      <picker range="{{accountOptions}}" value="{{accountIndex}}" bindchange="onAccountChange">
        <view class="account-filter">
          <text class="account-label">账号</text>
          <text class="account-value">{{accountOptions[accountIndex]}}</text>
        </view>
      </picker>
      <button class="manage-link" bindtap="onOpenCategories">管理</button>
    </view>

    <scroll-view class="chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chip-track">
        <button
          wx:for="{{categoryRows}}"
          wx:key="id"
          class="filter-chip {{selectedCategoryId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectCategory"
        >
          <text>{{item.name}}</text>
          <text class="chip-count">{{item.count}}条</text>
        </button>
      </view>
    </scroll-view>
  </view>

  <view class="list-header">
    <view>
      <text class="section-title">{{activeTab === 'title' ? '标题列表' : '文案列表'}}</text>
      <text class="section-note">{{activeTab === 'title' ? titleItems.length : copyItems.length}} 条内容</text>
    </view>
    <button class="subtle-button" data-action="{{activeTab === 'title' ? '整理标题' : '整理文案'}}" bindtap="onLocalAction">整理</button>
  </view>

  <view wx:if="{{activeTab === 'title'}}" class="content-section">
    <view wx:if="{{titleItems.length === 0}}" class="empty-state">
      <text class="empty-title">暂无标题</text>
      <text class="empty-copy">新增一条标题开始整理</text>
    </view>
    <view wx:for="{{titleItems}}" wx:key="id" class="library-row">
      <view class="row-main">
        <text class="star-index">★ {{index + 1}}</text>
        <view class="row-copy">
          <text class="row-title">{{item.text}}</text>
          <text class="row-meta">{{item.category}} · {{accountOptions[accountIndex]}}</text>
        </view>
      </view>
      <view class="row-actions">
        <button class="row-button" data-id="{{item.id}}" bindtap="onCopyTitle">复制</button>
        <button class="row-button" data-action="修改标题" bindtap="onLocalAction">修改</button>
        <button class="row-button danger" data-action="删除标题" bindtap="onLocalAction">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'copy'}}" class="content-section">
    <view wx:if="{{copyItems.length === 0}}" class="empty-state">
      <text class="empty-title">暂无文案</text>
      <text class="empty-copy">新增一条文案开始整理</text>
    </view>
    <view wx:for="{{copyItems}}" wx:key="id" class="library-row">
      <view class="row-main">
        <text class="star-index">★ {{index + 1}}</text>
        <view class="row-copy">
          <text class="row-title">{{item.summary}}</text>
          <text class="row-meta">{{item.category}} · {{accountOptions[accountIndex]}}</text>
        </view>
      </view>
      <view class="row-actions">
        <button class="row-button" data-id="{{item.id}}" bindtap="onCopyCopy">复制</button>
        <button class="row-button" data-id="{{item.id}}" bindtap="onToggleCopyExpand">
          <text wx:if="{{expandedCopyId === item.id}}">收起</text>
          <text wx:else>展开</text>
        </button>
        <button class="row-button" data-action="修改文案" bindtap="onLocalAction">修改</button>
        <button class="row-button danger" data-action="删除文案" bindtap="onLocalAction">删除</button>
      </view>

      <view wx:if="{{expandedCopyId === item.id}}" class="copy-detail-box">
        <text wx:for="{{item.lines}}" wx:key="*this" class="copy-line">{{item}}</text>
      </view>
    </view>
  </view>
</view>
