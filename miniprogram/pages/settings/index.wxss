.settings-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
  background: #f4f7fb;
  color: #111827;
}

.panel {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 8rpx;
  background: #ffffff;
}

.panel-title,
.panel-copy,
.contact-line {
  display: block;
}

.panel-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.panel-copy {
  margin-top: 12rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}

.contact-line {
  margin-top: 14rpx;
  color: #1e64d8;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.link-row {
  width: 100%;
  min-height: 66rpx;
  margin: 16rpx 0 0;
  border: 1rpx solid #d7e6ff;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #0f6fdc;
  font-size: 26rpx;
  line-height: 66rpx;
  text-align: left;
}

.logout-button {
  width: 100%;
  min-height: 78rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: #d94c4c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 78rpx;
}
