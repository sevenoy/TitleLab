.detail {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.detail-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 20rpx 0 8rpx;
}

.detail-title {
  color: #162033;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.24;
}

.detail-meta {
  color: #697386;
  font-size: 25rpx;
}

.section {
  padding: 24rpx;
  border: 1rpx solid #dde5ef;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-label {
  display: block;
  margin-bottom: 12rpx;
  color: #8a3c2f;
  font-size: 23rpx;
  font-weight: 700;
}

.section-copy {
  display: block;
  color: #283447;
  font-size: 28rpx;
  line-height: 1.6;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  background: #edf7f5;
  color: #0f766e;
  font-size: 23rpx;
  line-height: 1.3;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.action-button {
  flex: 1;
  min-height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.action-button.primary {
  background: #0f766e;
  color: #ffffff;
}

.action-button.secondary {
  border: 1rpx solid #b9c6d6;
  background: #ffffff;
  color: #283447;
}

.missing {
  display: flex;
  min-height: 420rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx dashed #b9c6d6;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.missing-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.missing-copy {
  color: #697386;
  font-size: 25rpx;
}
